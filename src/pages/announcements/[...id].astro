---
import { getCollection, render, type CollectionEntry } from "astro:content";
import "../../styles/global.css";
import "../../styles/prototype.css";

export async function getStaticPaths() {
  const announcements = await getCollection("announcements", ({ data }) => !data.draft);
  return announcements.map((post) => ({ params: { id: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<"announcements"> };
const { post } = Astro.props;
const { Content } = await render(post);
const displayDate = post.data.date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={post.data.summary} />
    <link rel="icon" type="image/png" href="/assets/images/cesa-logo.png" />
    <title>{post.data.title} | CESA</title>
  </head>
  <body class="bg-background text-foreground">
    <header class="border-b border-border"><div class="page-grid mx-auto flex h-16 max-w-[1440px] items-center justify-between px-5 md:px-9"><a href="/" class="flex items-center gap-3" aria-label="CESA home"><span class="font-mono-label text-xs uppercase text-primary">CESA / UW Seattle</span></a><a href="/announcements/" class="button-outline inline-flex">Back to announcements</a></div></header>
    <main class="page-grid mx-auto min-h-screen max-w-[1440px] px-5 py-16 md:px-9 md:py-24">
      <article class="mx-auto max-w-3xl">
        <p class="eyebrow text-primary">{post.data.category} / {displayDate}</p>
        <h1 class="mt-6 font-display text-5xl font-light leading-none md:text-7xl">{post.data.title}</h1>
        <p class="mt-7 text-xl leading-relaxed text-muted-foreground">{post.data.summary}</p>
        {post.data.image && <img src={post.data.image} alt="" class="mt-10 aspect-[16/9] w-full object-cover" />}
        <div class="announcement-body mt-12 border-t border-border pt-10"><Content /></div>
      </article>
    </main>
  </body>
</html>
